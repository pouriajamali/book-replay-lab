[
  {
    "name": "snapshot and update",
    "input": [
      "S 10 100 6 103 4",
      "U 11 B 101 2"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "UPDATE|1|11|101|2|103|4"
    ]
  },
  {
    "name": "replace quantity",
    "input": [
      "S 10 100 6 103 4",
      "U 11 B 100 9"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "UPDATE|1|11|100|9|103|4"
    ]
  },
  {
    "name": "delete top reveals next level",
    "input": [
      "S 10 100 6 103 4",
      "U 11 B 99 7",
      "U 12 B 100 0"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "UPDATE|1|11|100|6|103|4",
      "UPDATE|1|12|99|7|103|4"
    ]
  },
  {
    "name": "empty side",
    "input": [
      "S 10 100 6 103 4",
      "U 11 A 103 0"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "UPDATE|1|11|100|6|-|-"
    ]
  },
  {
    "name": "gap then snapshot recovery",
    "input": [
      "S 10 100 6 103 4",
      "U 11 B 101 2",
      "U 13 A 104 5",
      "U 12 B 99 4",
      "S 20 100 8 104 3",
      "U 21 A 103 2"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "UPDATE|1|11|101|2|103|4",
      "GAP|0|11|101|2|103|4",
      "NOT_READY|0|11|101|2|103|4",
      "SNAPSHOT|1|20|100|8|104|3",
      "UPDATE|1|21|100|8|103|2"
    ]
  },
  {
    "name": "stale update ignored",
    "input": [
      "S 10 100 6 103 4",
      "U 10 B 101 2",
      "U 9 A 102 7"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "STALE|1|10|100|6|103|4",
      "STALE|1|10|100|6|103|4"
    ]
  },
  {
    "name": "crossed update atomic rejection",
    "input": [
      "S 10 100 6 103 4",
      "U 11 B 103 1"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "CROSSED|0|10|100|6|103|4"
    ]
  },
  {
    "name": "crossed snapshot preserves previous state",
    "input": [
      "S 10 100 6 103 4",
      "S 20 105 9 104 2"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "CROSSED|0|10|100|6|103|4"
    ]
  },
  {
    "name": "stale snapshot fails closed",
    "input": [
      "S 10 100 6 103 4",
      "S 9 99 1 104 1"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "STALE_SNAPSHOT|0|10|100|6|103|4"
    ]
  },
  {
    "name": "disconnect requires snapshot",
    "input": [
      "S 10 100 6 103 4",
      "D",
      "U 11 B 101 2",
      "S 10 100 6 103 4"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "DISCONNECTED|0|10|100|6|103|4",
      "NOT_READY|0|10|100|6|103|4",
      "SNAPSHOT|1|10|100|6|103|4"
    ]
  },
  {
    "name": "unknown delete rejected",
    "input": [
      "S 10 100 6 103 4",
      "U 11 A 104 0"
    ],
    "expected": [
      "SNAPSHOT|1|10|100|6|103|4",
      "UNKNOWN_DELETE|0|10|100|6|103|4"
    ]
  },
  {
    "name": "update before snapshot",
    "input": [
      "U 1 B 100 2"
    ],
    "expected": [
      "NOT_READY|0|0|-|-|-|-"
    ]
  },
  {
